# Copy to .env, change both passwords, and set CARDO_SALT if you want the collector. .env is
# gitignored.
#
# These credentials protect pseudonymous engineering telemetry. Treat them as you would any other
# production secret.

CLICKHOUSE_USER=cardo
CLICKHOUSE_PASSWORD=change-me

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Pseudonymization salt for the collector. Without it the collector refuses every OTel batch
# (hooks still flow, since they carry no identity) and logs a REFUSED line saying why.
# Generate one with:  openssl rand -hex 32
#
# In this single-machine stack the salt unavoidably sits beside the database password. That is an
# evaluation compromise, not the design: in a real deployment the collector's salt comes from the
# security team's secret store and the analytics environment never sees it (ADR-0006). Use the
# same salt as `cardo poll`, or the two paths will give one engineer two pseudonyms.
CARDO_SALT=
CARDO_SALT_VERSION=v1

# Optional. A regex naming your organization's own slash commands, subagents, MCP servers and
# instructions files -- the artifacts you ship. The dashboards use it to tell what you shipped from
# what engineers built for themselves. It is also the only way an instructions file's name is
# recorded: name a versioned file acme-standards-v7.md and Cardo can see who still loads v6.
# Empty means none are named.
#   CARDO_ORG_ARTIFACTS=^acme-
CARDO_ORG_ARTIFACTS=

# Optional. "all" (the default) records the names of commands, subagents and MCP servers that
# engineers define themselves. "org-only" is the strict mode: every name not matching
# CARDO_ORG_ARTIFACTS is recorded as "custom". Any value other than "all" is strict.
CARDO_ARTIFACT_NAMES=all

# Optional. A regex naming your organization's repositories, matched against the lowercased
# host/owner/name (github.com/acme/widgets) whatever form the remote URL takes. A matching
# repository is recorded by that name; any other is recorded as external plus its host
# (gitlab.com), never its full URL (ADR-0035). Empty means every repository is external.
#   CARDO_ORG_REPOS=^github[.]com/acme/
# Write a literal dot as [.], not with a backslash: the pattern is pasted into the collector's
# configuration inside a quoted string, where a backslash stops the collector from starting.
CARDO_ORG_REPOS=

# Only for the network overlay (docker-compose.network.yml, `make stack-up-network`): the name the
# certificate is for, and the absolute path of a directory holding its fullchain.pem and
# privkey.pem. Keep that directory outside the repository. See "Serving a team over the network"
# in README.md.
#   CARDO_HOSTNAME=cardo.example.com
#   CARDO_TLS_DIR=/etc/cardo/tls

# Optional. How many people a home-grown artifact name or a cohort needs before a dashboard shows
# it; below that it is counted as "other". At least 5, which is also the default. It can be raised
# (a works council may ask for 10) and never lowered (ADR-0029). The organization's own names
# are always shown. The migrate service applies it: run `docker compose up -d` after changing it.
CARDO_MIN_GROUP_SIZE=
